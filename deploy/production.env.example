# cms-admin on the live server (the api repo's deploy/README.md, step 5). Copy to .env in this repo, then
# `npm run build`. Everything here is built into the files, so a change needs a new build.

# The API's public address.
VITE_API_URL="https://api.nodepress.brainxdemo.com"

# New site saves a one-word address under this domain: bistro becomes bistro.nodepress.brainxdemo.com.
VITE_SITE_DOMAIN="nodepress.brainxdemo.com"

# VITE_SITE_SCHEME and VITE_SITE_PORT stay unset: links to the sites are https://<site address>/.
