{
  "name": "cms-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:flow": "FLOW=1 playwright test --project=flow",
    "tokens": "sh scripts/check-tokens.sh",
    "blocks:sync": "node scripts/sync-blocks.mjs",
    "blocks:check": "node scripts/sync-blocks.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/archivo-narrow": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/karla": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lucide-react": "1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
