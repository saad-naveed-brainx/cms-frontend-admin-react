VITE_API_URL="http://localhost:4000"

# How the admin links to the public website (src/site-links.ts). Locally the website runs on its own
# port; leave both unset in production, where links are https://<site address>/.
VITE_SITE_SCHEME="http"
VITE_SITE_PORT="3000"

# Live only: the platform's domain for sites (src/site-links.ts, D-045). A one-word address typed in
# New site is saved under it: bistro becomes bistro.nodepress.brainxdemo.com. Leave unset locally.
VITE_SITE_DOMAIN=""
